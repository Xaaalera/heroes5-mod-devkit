msgid "xalkit.storage_low_space"
msgstr "Не хватает места для тестовой установки в {path}. Нужно {needed} ГиБ, доступно {available} ГиБ. Выполни xkit storage clean или выбери другой диск для проектов."
msgid "xalkit.storage_restore_dump_help"
msgstr "Распаковать архивный дамп сбоя с проверкой исходной контрольной суммы."

